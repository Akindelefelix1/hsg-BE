NODE_ENV=development
PORT=4000

# Use Neon's pooled URL for the API and its direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST/DATABASE?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST/DATABASE?sslmode=require&channel_binding=require
DB_SSL=true

CORS_ORIGINS=http://localhost:3000
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-BASE-URL
NEON_AUTH_JWKS_URL=https://YOUR-NEON-AUTH-JWKS-URL

# Copy these four values from Neon Console > Connect > Storage.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_TOKEN_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET
AWS_ENDPOINT_URL_S3=https://YOUR-NEON-BRANCH-STORAGE-ENDPOINT
STORAGE_BUCKET=hsg-storage
